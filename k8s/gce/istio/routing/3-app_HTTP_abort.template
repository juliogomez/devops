apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: myhero-app
spec:
  hosts:
  - "<YOUR_APP_DNS_NAME>"
  gateways:
  - myhero-gateway
  - mesh
  http:
  - fault:
      abort:
        percentage: 
          value: 100
        httpStatus: 500
    route:
    - destination:
        host: myhero-app.myhero.svc.cluster.local
